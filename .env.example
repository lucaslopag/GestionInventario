# Copia este archivo a .env y pon tus propios valores. El archivo .env no se sube a git.

# Secreto para firmar los JWT. Tiene que ser el mismo en api-gateway y ms-users.
# Usa una cadena aleatoria de 64 caracteres o mas.
JWT_SECRET=pon_aqui_un_secreto_largo_y_aleatorio

# Cuenta de correo que usa ms-mail para enviar los emails de confirmacion.
# En Gmail hay que usar una contrasena de aplicacion, no la contrasena normal.
MAIL_USERNAME=tu_correo@ejemplo.com
MAIL_PASSWORD=pon_aqui_la_contrasena_de_aplicacion

# Base de datos y RabbitMQ (valores de desarrollo)
MYSQL_USER=tfg
MYSQL_PASSWORD=pon_aqui_tu_contrasena
