# =============================================================
# PLANTILLA DE CONFIGURACIÓN (.env.example)
# Copia este archivo como '.env' y rellena los valores reales.
# NO subas el archivo '.env' real al repositorio.
# =============================================================

# -------------------------------------------------------------
# SEGURIDAD (JWT)
# -------------------------------------------------------------
# Genera una clave segura de al menos 64 caracteres
JWT_SECRET=tu_secreto_super_seguro_de_64_caracteres_minimo_aqui
# Tiempo de vida del token (ej: 3600000 ms = 1 hora)
JWT_EXPIRATION_MS=3600000

# -------------------------------------------------------------
# BASE DE DATOS (MySQL)
# -------------------------------------------------------------
MYSQL_ROOT_PASSWORD=password_maestro
MYSQL_USER=usuario_app
MYSQL_PASSWORD=password_usuario_app

# -------------------------------------------------------------
# MENSAJERÍA (RabbitMQ)
# -------------------------------------------------------------
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_QUEUE_AUDIT=cola.auditoria
RABBITMQ_QUEUE_AUDIT_DLQ=cola.auditoria.dlq
RABBITMQ_QUEUE_MAIL=cola.mails
RABBITMQ_QUEUE_MAIL_DLQ=cola.mails.dlq

# -------------------------------------------------------------
# CORREO ELECTRÓNICO (SMTP)
# -------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=ejemplo@gmail.com
MAIL_PASSWORD=tu_contrasena_de_aplicacion_aqui

# -------------------------------------------------------------
# GENERAL Y SERVICIOS
# -------------------------------------------------------------
# URL base para enlaces en emails (confirmación de registro)
APP_BASE_URL=http://localhost:80
# URL de registro de Eureka Server
EUREKA_SERVICE_URL=http://eureka-server:8761/eureka
